<!-- ========================================================================== -->
<!-- PROYECTO: di.unidad2.ejercicio9                                            -->
<!-- EJERCICIO: Unidad 2 - Ejercicio 9 (Formulario de Login Matisse Dividido)    -->
<!-- CARACTERISTICAS: Ventana dividida en dos columnas:                        -->
<!--                  - Izquierda: fondo blanco con logotipo y arte de Matisse. -->
<!--                  - Derecha: fondo crema (#FAF5EE), mensaje de bienvenida,   -->
<!--                    campos redondeados con icono y botón Inicio de Sesión.   -->
<!-- ========================================================================== -->

<Window x:Class="di.unidad2.ejercicio9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:di.unidad2.ejercicio9"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="IES Henri Matisse - Login"
        Height="470" Width="720"
        MinHeight="470" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#FAF5EE">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Columna izquierda: Ilustracion artística Matisse (45%) -->
            <ColumnDefinition Width="45*" />
            <!-- Columna derecha: Formulario de bienvenida y login (55%) -->
            <ColumnDefinition Width="55*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================== -->
        <!-- PANEL IZQUIERDO: ARTE MATISSE                                  -->
        <!-- ============================================================== -->
        <Border Grid.Column="0" Background="#FFFFFF">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Logotipo del IES Henri Matisse en la esquina superior izquierda -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="5,0,0,10">
                    <Image Source="Recursos/iconos/matisse.png" 
                           Height="22" 
                           Stretch="Uniform" 
                           HorizontalAlignment="Left" 
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </StackPanel>

                <!-- Ilustracion central de Matisse -->
                <Image Grid.Row="1" 
                       Source="Recursos/iconos/LoginImagen.png" 
                       Stretch="Uniform" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="10" />
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- PANEL DERECHO: FORMULARIO DE ACCESO                            -->
        <!-- ============================================================== -->
        <Border Grid.Column="1" Background="#FAF5EE">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="310">
                <StackPanel Orientation="Vertical">
                    
                    <!-- Titulo Principal -->
                    <TextBlock Text="BIENVENIDOS"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#1E2022"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />

                    <!-- Mensaje de bienvenida / subtítulo -->
                    <TextBlock Text="Para trabajar con nuestra aplicación, por favor,&#x0a;introducid vuestra credenciales para iniciar sesión"
                               FontSize="11.5"
                               Foreground="#75777A"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               LineHeight="16"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28" />

                    <!-- Campo: Nombre de usuario -->
                    <Border Background="#EBF0F6"
                            CornerRadius="3"
                            Height="40"
                            Margin="0,0,0,14"
                            Padding="10,0,10,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- Icono de usuario -->
                            <mat:PackIcon Grid.Column="0" 
                                          Kind="AccountOutline" 
                                          Width="20" 
                                          Height="20" 
                                          Foreground="#7B828C" 
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />

                            <!-- Entrada de texto con marca de agua -->
                            <TextBox Grid.Column="1"
                                     mat:HintAssist.Hint="Nombre de usuario"
                                     mat:HintAssist.Foreground="#8D95A1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#2C3238"
                                     FontSize="12.5"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Padding="0" />
                        </Grid>
                    </Border>

                    <!-- Campo: Clave de acceso -->
                    <Border Background="#EBF0F6"
                            CornerRadius="3"
                            Height="40"
                            Margin="0,0,0,22"
                            Padding="10,0,10,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Icono de candado / clave -->
                            <mat:PackIcon Grid.Column="0" 
                                          Kind="LockOutline" 
                                          Width="19" 
                                          Height="19" 
                                          Foreground="#7B828C" 
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />

                            <!-- Entrada de password con marca de agua -->
                            <PasswordBox Grid.Column="1"
                                         mat:HintAssist.Hint="Clave de acceso"
                                         mat:HintAssist.Foreground="#8D95A1"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#2C3238"
                                         FontSize="12.5"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Padding="0" />
                        </Grid>
                    </Border>

                    <!-- Boton: Inicio de Sesión -->
                    <Button Content="Inicio de Sesión"
                            Background="#1856A1"
                            Foreground="White"
                            BorderThickness="0"
                            Height="38"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            mat:ButtonAssist.CornerRadius="3"
                            HorizontalAlignment="Stretch"
                            Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
