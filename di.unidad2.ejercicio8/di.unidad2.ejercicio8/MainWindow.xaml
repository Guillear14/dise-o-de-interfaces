<!-- ========================================================================== -->
<!-- PROYECTO: di.unidad2.ejercicio8                                            -->
<!-- EJERCICIO: Unidad 2 - Ejercicio 8 (IES Matisse con Degradado y Watermark)  -->
<!-- CARACTERISTICAS: Fondo oscuro (#1E1E1E), rectángulo superior inclinado con -->
<!--                  degradado (LinearGradientBrush), botón con el mismo       -->
<!--                  degradado y marcas de agua con TextBoxHelper.Watermark.   -->
<!-- ========================================================================== -->

<Window x:Class="di.unidad2.ejercicio8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:di.unidad2.ejercicio8"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Title="MainWindow" Height="500" Width="600">

    <Grid>
        <!-- Rectangulo superior decorativo inclinado con degradado rojo a naranja -->
        <Rectangle Height="200" Width="700" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-105,-112,0,0">
            <!-- Relleno con degradado lineal (LinearGradientBrush) -->
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#D14235" Offset="0.0"/> <!-- Rojo oscuro -->
                    <GradientStop Color="#EB8643" Offset="1.0"/> <!-- Naranja brillante -->
                </LinearGradientBrush>
            </Rectangle.Fill>
            <!-- Inclinamos el rectangulo -5 grados con RotateTransform -->
            <Rectangle.LayoutTransform>
                <RotateTransform Angle="-5" />
            </Rectangle.LayoutTransform>
        </Rectangle>

        <!-- Titulos en blanco -->
        <TextBlock Text="IES MATISSE" Foreground="White" FontWeight="Bold" Margin="30,30,0,0" FontSize="30" />
        <TextBlock Text="INVENTARIO MATISSE" FontSize="25" FontWeight="Bold" Foreground="White" Margin="30,180,0,0" />
        <TextBlock Text="Login" Foreground="White" FontSize="20" Margin="30,220,0,0" />

        <!-- TextBox con borde blanco y texto centrado -->
        <TextBox mat:HintAssist.Hint="Nombre de usuario" 
                 BorderBrush="White" Foreground="White" Margin="0,190,250,130" 
                 BorderThickness="1" Width="300" Height="50" HorizontalContentAlignment="Center" />

        <!-- PasswordBox para clave de acceso con borde blanco -->
        <PasswordBox mat:HintAssist.Hint="Clave de acceso" 
                     BorderBrush="White" Foreground="White" Margin="0,190,250,0" 
                     BorderThickness="1" Width="300" Height="50" HorizontalContentAlignment="Center" />

        <!-- Boton LOGIN cuyo borde tiene exactamente el mismo degradado superior -->
        <Button Content="LOGIN" Background="Transparent" Foreground="#EB8643" Width="100" Height="50" Margin="0,320,450,0">
            <Button.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#D14235" Offset="0.0"/>
                    <GradientStop Color="#EB8643" Offset="1.0"/>
                </LinearGradientBrush>
            </Button.BorderBrush>
        </Button>

        <!-- Enlace de olvido de clave al pie -->
        <TextBlock Text="¿OLVIDASTES LA CONTRASEÑA?" Foreground="#EB8643" VerticalAlignment="Bottom" Margin="30,0,0,30" Cursor="Hand" />
    </Grid>
</Window>
