<!-- ========================================================================== -->
<!-- PROYECTO: di.unidad2.ejercicio10                                           -->
<!-- EJERCICIO: Unidad 2 - Ejercicio 10 (Login con Fondo Degradado y Redes)     -->
<!-- CARACTERISTICAS:                                                           -->
<!--   - Fondo con LinearGradientBrush de #b22d2f (rojo) a #1b63b8 (azul).      -->
<!--   - Tarjeta central oscura (#1A1D20) que ocupa el alto de la ventana.      -->
<!--   - Campos Username y Contraseña en píldoras con borde azul (#254B62).     -->
<!--   - Enlace "¿Has olvidado la contraseña?".                                 -->
<!--   - Botón Login redondeado con borde verde (#2D604E).                      -->
<!--   - Iconos sociales blancos en la parte inferior (Facebook, Twitter, G+).  -->
<!-- ========================================================================== -->

<Window x:Class="di.unidad2.ejercicio10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:di.unidad2.ejercicio10"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="IES Henri Matisse - Login"
        Height="540" Width="840"
        MinHeight="540" MinWidth="840"
        WindowStartupLocation="CenterScreen">

    <!-- Fondo de la pantalla con degradado lineal horizontal especificado en el enunciado -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#b22d2f" Offset="0.0"/>
                <GradientStop Color="#1b63b8" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Tarjeta central oscura -->
        <Border Width="500"
                Background="#1A1D20"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch">
            <StackPanel Orientation="Vertical"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="0,15,0,15">

                <!-- Título principal con espaciado amplio -->
                <TextBlock Text="L O G I N"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />

                <!-- Subtítulo explicativo -->
                <TextBlock Text="Por favor introduce tu usuario y clave"
                           FontSize="12.5"
                           Foreground="#9DA7B2"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30" />

                <!-- Campo píldora: Username -->
                <Border Width="340"
                        Height="46"
                        CornerRadius="23"
                        BorderThickness="1.2"
                        BorderBrush="#254B62"
                        Background="#1A1D20"
                        Margin="0,0,0,16"
                        Padding="16,0,16,0">
                    <TextBox mat:HintAssist.Hint="Username"
                             mat:HintAssist.Foreground="#5A6C7D"
                             mat:TextFieldAssist.UnderlineBrush="Transparent"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#B0BEC5"
                             FontSize="13"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             Padding="0" />
                </Border>

                <!-- Campo píldora: Contraseña -->
                <Border Width="340"
                        Height="46"
                        CornerRadius="23"
                        BorderThickness="1.2"
                        BorderBrush="#254B62"
                        Background="#1A1D20"
                        Margin="0,0,0,22"
                        Padding="16,0,16,0">
                    <PasswordBox mat:HintAssist.Hint="Contraseña"
                                 mat:HintAssist.Foreground="#5A6C7D"
                                 mat:TextFieldAssist.UnderlineBrush="Transparent"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#B0BEC5"
                                 FontSize="13"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Padding="0" />
                </Border>

                <!-- Enlace: ¿Has olvidado la contraseña? -->
                <TextBlock Text="¿Has olvidado la contraseña?"
                           FontSize="12.5"
                           FontWeight="Normal"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Cursor="Hand"
                           Margin="0,0,0,25" />

                <!-- Botón Login píldora con borde verde -->
                <Button Content="Login"
                        Width="160"
                        Height="42"
                        FontSize="13"
                        Foreground="#8C98A0"
                        Background="Transparent"
                        BorderBrush="#2D604E"
                        BorderThickness="1.2"
                        mat:ButtonAssist.CornerRadius="21"
                        HorizontalAlignment="Center"
                        Cursor="Hand"
                        Margin="0,0,0,32" />

                <!-- Iconos de redes sociales en blanco -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <!-- Facebook -->
                    <Image Source="Recursos/iconos/facebookblanco.png"
                           Width="22" Height="22"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Cursor="Hand"
                           Margin="14,0" />

                    <!-- Twitter -->
                    <Image Source="Recursos/iconos/twitter.png"
                           Width="22" Height="22"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Cursor="Hand"
                           Margin="14,0" />

                    <!-- Google+ -->
                    <Image Source="Recursos/iconos/googleplus.png"
                           Width="26" Height="26"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Cursor="Hand"
                           Margin="14,0" />
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
